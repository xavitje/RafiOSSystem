# Instellingen voor het bouwen van RafiOS

# Naam van het image (zelfde als de repository)
IMAGE_NAME=rafios

# VERANDER DIT: je GitHub-gebruikersnaam (kleine letters)
REPO_ORGANIZATION="JOUW-GITHUB-NAAM"

IMAGE_DESC="RafiOS: een snel, aanpasbaar game-OS"
IMAGE_KEYWORDS="bootc,oci,linux,gaming,rafios"

# Later vervangen door de URL van het RafiOS-logo
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
